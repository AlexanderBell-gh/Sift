VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Optional: override the Worker API base for local dev (defaults to production).
# Dev server omits CSP so no connect-src conflict; production builds keep the
# pinned prod host in public/_headers + vite.config.ts.
# VITE_API_BASE=http://localhost:5173

# Ops CLI (bin/sift.mjs) — optional, only watchlist reads need the admin pair.
# Real secrets: never commit these values. The CLI loads .env itself; real env wins.
# SIFT_API_BASE=https://siftapi.blackmesa.workers.dev
# SIFT_ADMIN_USER=
# SIFT_ADMIN_PASS=
